{
  "schema": "tcf-reproduction-v1",
  "result_scope": "strict full-sort reproduction",
  "environment": {
    "python_major_minor": "3.8",
    "torch": "1.13.1",
    "numpy": "1.21.6",
    "scipy": "1.7.3",
    "tqdm": "4.67.1",
    "cuda": "11.7"
  },
  "training": {
    "seed": 42,
    "batch_size": 256,
    "epochs": 200,
    "patience": 10,
    "num_workers": 0,
    "strict_full_sort_mask": true,
    "skip_test_after_training": true,
    "paired_time_factorial": true,
    "load_model": null,
    "warmstart": null,
    "train_scope": "all"
  },
  "evaluation": {
    "metrics": ["HR@10", "NDCG@10", "HR@20", "NDCG@20"],
    "verification_absolute_tolerance": 0.001
  },
  "datasets": {
    "Beauty": {
      "data_name": "Beauty",
      "item_file": "src/data/Beauty.txt",
      "time_file": "src/data/Beauty_time_time.txt",
      "lr": 0.00025,
      "dropout": 0.5,
      "num_heads": 8,
      "alpha": 0.2,
      "weight_decay": 0.0,
      "time_embedding_scale": 1.0,
      "complex_dff_epsilon": 0.05,
      "complex_dff_rank": 8,
      "markov_window": 5,
      "markov_tau": 1.75,
      "markov_lambda": 0.6,
      "expected": {
        "HR@10": 0.1053973080534812,
        "NDCG@10": 0.06403989351528021,
        "HR@20": 0.14121540043822386,
        "NDCG@20": 0.07301370313872714
      }
    },
    "Sports": {
      "data_name": "Sports_and_Outdoors",
      "item_file": "src/data/Sports_and_Outdoors.txt",
